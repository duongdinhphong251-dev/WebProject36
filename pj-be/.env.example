PORT=3000
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_NAME=agentspa
DB_USER=agentspa
DB_PASSWORD=

# Tối đa connection Postgres mỗi process (mặc định 5). Prod: DB_POOL_MAX × max Cloud Run instances < max_connections DB.
DB_POOL_MAX=50

# Google Maps API — dùng để fetch ảnh spa từ Google Places Photos API (v1)
GOOGLE_MAPS_API_KEY=

# Google Cloud Storage — bucket lưu ảnh spa sau khi fetch từ Google
GCS_BUCKET_NAME=
# Đường dẫn tới service account key JSON (để trống nếu dùng Application Default Credentials)
GCS_KEY_FILE=
# GCS signed URL TTL (seconds) — mặc định 72h
SIGNED_URL_TTL_SECONDS=259200

# Fake view base (lazy-init 500–9999) + real tracking. yes/true/1 = bật (mặc định), no/false/0 = tắt
FAKE_ENGAGEMENT_ENABLED=yes

ADMIN_BASIC_AUTH_USERNAME=
ADMIN_BASIC_AUTH_PASSWORD=
ADMIN_SESSION_SECRET=
