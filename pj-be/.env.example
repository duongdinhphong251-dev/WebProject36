PORT=8081
DB_HOST=localhost
DB_PORT=5433
DB_NAME=tuoi_db
DB_USER=postgres
DB_PASSWORD=postgres

# Tạo chuỗi ngẫu nhiên dài ít nhất 32 byte trước khi chạy API.
JWT_SECRET=replace-with-a-long-random-secret-before-running

# Chỉ dùng tài khoản mẫu trên máy phát triển.
SEED_ADMIN_PHONE=0900000001
SEED_ADMIN_PASSWORD=Admin@123456
SEED_OWNER_PHONE=0900000002
SEED_OWNER_PASSWORD=Owner@123456
SEED_USER_PHONE=0900000003
SEED_USER_PASSWORD=User@123456
